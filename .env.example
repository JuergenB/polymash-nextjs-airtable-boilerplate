# Copy to .env.local and fill in. Next.js loads .env.local by itself.
# The dev server port is not set here: Next.js starts the server before it
# reads env files. Use `npm run dev -- -p 4000` instead.

# ===========================================
# AUTH.JS CONFIGURATION
# ===========================================
# Required. Generate with: openssl rand -base64 33
AUTH_SECRET=

# Users in format: id:username:password (comma-separated for multiple users)
# Example: 1:admin@example.com:mypassword,2:editor@example.com:editorpass
# Passwords must not contain : , $ or #
AUTH_USERS=

# Name of the session cookie. Must differ from every other Auth.js app you run
# on localhost, or the apps log each other out. Leave empty to use
# "<package.json name>.session-token".
AUTH_COOKIE_NAME=

# Uncomment only when you run `npm run build && npm start` yourself or host
# behind your own proxy. Not needed for `npm run dev` or on Vercel. Leave the
# line commented out rather than empty: an empty value switches the check on
# again, even in development.
# AUTH_TRUST_HOST=true

# ===========================================
# AIRTABLE (Primary data store)
# ===========================================
# Personal access token: https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write (add schema.bases:read and
# schema.bases:write if you change tables through the API). Add your base.
AIRTABLE_API_KEY=

# Base ID, from the Airtable URL: https://airtable.com/appXXXXXX/...
AIRTABLE_BASE_ID=

# Table IDs, added as you create tables for this project
# AIRTABLE_[TABLE_NAME]_TABLE_ID=

# ===========================================
# AI: ANTHROPIC CLAUDE
# ===========================================
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ===========================================
# AI: OPENAI
# ===========================================
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ===========================================
# AI: PERPLEXITY (Web-grounded search)
# ===========================================
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ===========================================
# WEB SCRAPING: FIRECRAWL
# ===========================================
# https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# ===========================================
# EMAIL / NOTIFICATIONS: RESEND
# ===========================================
# https://resend.com/api-keys
RESEND_API_KEY=

# ===========================================
# IMAGE GENERATION: REPLICATE
# ===========================================
# Access dozens of image generation models (Flux, SDXL, etc.) via one API
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ===========================================
# INFOGRAPHICS & DIAGRAMS: NAPKIN AI
# ===========================================
# Generate infographics, flowcharts, and process diagrams from text
# https://napkin.ai (API docs at https://api.napkin.ai/v1)
NAPKIN_API_KEY=

# ===========================================
# MEDIA: UNSPLASH
# ===========================================
# Access Key: https://unsplash.com/oauth/applications
# Only "Public access" permission needed
UNSPLASH_ACCESS_KEY=

# ===========================================
# GOOGLE (optional, for Custom Search API if needed)
# ===========================================
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
