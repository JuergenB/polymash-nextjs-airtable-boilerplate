# ===========================================
# LOCAL DEV SERVER
# ===========================================
# Change this to avoid port conflicts when running multiple projects locally
PORT=4000

# ===========================================
# AUTH.JS CONFIGURATION
# ===========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Users in format: id:username:password (comma-separated for multiple users)
# Example: 1:admin@example.com:mypassword,2:editor@example.com:editorpass
AUTH_USERS=

# ===========================================
# AIRTABLE (Primary data store)
# ===========================================
# Personal Access Token — https://airtable.com/create/tokens
AIRTABLE_API_KEY=

# Base ID — find in Airtable URL: https://airtable.com/appXXXXXX/...
AIRTABLE_BASE_ID=

# Table IDs — add as you create tables for this project
# AIRTABLE_[TABLE_NAME]_TABLE_ID=

# ===========================================
# AI — ANTHROPIC CLAUDE
# ===========================================
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ===========================================
# AI — OPENAI
# ===========================================
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ===========================================
# AI — PERPLEXITY (Web-grounded search)
# ===========================================
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ===========================================
# WEB SCRAPING — FIRECRAWL
# ===========================================
# https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# ===========================================
# EMAIL / NOTIFICATIONS — RESEND
# ===========================================
# https://resend.com/api-keys
RESEND_API_KEY=

# ===========================================
# IMAGE GENERATION — REPLICATE
# ===========================================
# Access dozens of image generation models (Flux, SDXL, etc.) via one API
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ===========================================
# INFOGRAPHICS & DIAGRAMS — NAPKIN AI
# ===========================================
# Generate infographics, flowcharts, and process diagrams from text
# https://napkin.ai — API docs at https://api.napkin.ai/v1
NAPKIN_API_KEY=

# ===========================================
# MEDIA — UNSPLASH
# ===========================================
# Access Key — https://unsplash.com/oauth/applications
# Only "Public access" permission needed
UNSPLASH_ACCESS_KEY=

# ===========================================
# GOOGLE (optional — for Custom Search API if needed)
# ===========================================
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
